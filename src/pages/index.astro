---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const thoughts = (await getCollection("thoughts"))
  .sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<BaseLayout>
  <section class="hero">
    <h1 class="h1">Market Eclipse</h1>
    <p class="sub">One structural market insight per day. No noise.</p>
    <p class="sub">
      A public market-thinking journal focused on structure, regimes, volatility, and behavior in Indian markets.
      No predictions. No recommendations. Just signal.
    </p>
  </section>

  <section class="section">
    <h2 class="h2">Latest thoughts</h2>
    <div class="list">
      {thoughts.map((post) => (
        <a class="card" href={`/thoughts/${post.slug}`}>
          <div class="card-title">{post.data.title}</div>
          <div class="card-meta">
            <span>{post.data.date.toLocaleDateString("en-IN", { year:"numeric", month:"short", day:"2-digit" })}</span>
            {post.data.tags?.slice(0,3).map((t) => <span class="pill">{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
